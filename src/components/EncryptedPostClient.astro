---
// EncryptedPostClient component - Client-side decryption with password verification
interface Props {
	postId: string;
	encryptedContent: {
		encrypted: string;
		salt: string;
		iv: string;
		authTag: string;
		algorithm?: string;
		iterations?: number;
	};
	summary?: string;
}

const { postId, encryptedContent, summary } = Astro.props;

// Get API base URL from environment variable (for separate API server)
const apiBaseUrl = import.meta.env.PUBLIC_API_BASE_URL || '';
---

<div id="encrypted-content" class="encrypted-wrapper" data-encrypted-content={JSON.stringify(encryptedContent)}>
	<div class="password-prompt">
		<div class="password-prompt__heading">
			<svg class="password-prompt__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
				<rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
				<path d="M7 11V7a5 5 0 0 1 10 0v4"/>
			</svg>
			<span class="password-prompt__title">加密内容</span>
		</div>
		{summary ? (
			<p class="password-prompt__summary">{summary}</p>
		) : null}
		<form id="password-form" class="password-form">
			<input
				type="password"
				id="password-input"
				class="password-field__input"
				placeholder="输入密码"
				autocomplete="off"
				required
				aria-describedby="error-message"
			/>
			<button type="submit" class="password-form__submit">解锁</button>
		</form>
		<div id="error-message" class="password-message password-message--error" style="display: none;" role="alert">
			<span class="password-message__dot"></span>
			密码错误，请重试
		</div>
		<div id="loading-message" class="password-message password-message--loading" style="display: none;" aria-live="polite">
			验证并解密中
			<span class="loading-dots">
				<span></span><span></span><span></span>
			</span>
		</div>
		<p class="prompt-note">如无密码可联系作者 · AES-256</p>
	</div>
	<div id="post-content" class="post-content" style="display: none;"></div>
</div>

<style>
	.encrypted-wrapper {
		width: 100%;
		max-width: 520px;
		margin: 10px 0;
	}

	@keyframes fadeUp {
		from { opacity: 0; transform: translateY(8px); }
		to   { opacity: 1; transform: translateY(0); }
	}

	.password-prompt {
		animation: fadeUp 0.4s ease both;
	}

	.password-prompt__heading {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
	}

	.password-prompt__icon {
		width: 16px;
		height: 16px;
		flex-shrink: 0;
		stroke: var(--muted);
	}

	.password-prompt__title {
		font-family: "Noto Serif SC", ui-serif, Georgia, serif;
		font-size: 15px;
		font-weight: 500;
		color: var(--text);
		margin: 0;
	}

	.password-prompt__summary {
		font-size: 14px;
		color: var(--muted);
		margin: 0 0 20px 0;
		line-height: 1.7;
	}

	.password-form {
		display: flex;
		gap: 10px;
		align-items: stretch;
		margin-top: 20px;
	}

	.password-field__input {
		flex: 1;
		padding: 9px 12px;
		border: 1px solid var(--border);
		border-radius: 3px;
		background: var(--bg);
		font-family: Georgia, serif;
		font-size: 14px;
		color: var(--text);
		outline: none;
		transition: border-color 0.15s;
		min-width: 0;
	}

	.password-field__input::placeholder {
		color: var(--faint);
		font-style: italic;
	}

	.password-field__input:focus {
		border-color: var(--muted);
	}

	.password-field__input.error {
		border-color: var(--accent);
	}

	.password-form__submit {
		padding: 9px 20px;
		background: var(--text);
		color: var(--bg);
		border: none;
		border-radius: 3px;
		font-family: "Noto Serif SC", ui-serif, Georgia, serif;
		font-size: 13px;
		letter-spacing: 0.06em;
		cursor: pointer;
		flex-shrink: 0;
		transition: opacity 0.15s;
	}

	.password-form__submit:hover {
		opacity: 0.75;
	}

	.password-form__submit:active {
		opacity: 0.6;
	}

	.password-form__submit:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}

	.password-message {
		margin-top: 10px;
		font-size: 12px;
		font-family: "Noto Serif SC", ui-serif, Georgia, serif;
		display: flex;
		align-items: center;
		gap: 6px;
		animation: fadeIn 0.2s ease;
	}

	@keyframes fadeIn {
		from { opacity: 0; }
		to   { opacity: 1; }
	}

	.password-message--error {
		color: var(--accent);
	}

	.password-message--loading {
		color: var(--muted);
	}

	.password-message__dot {
		display: inline-block;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--accent);
		flex-shrink: 0;
	}

	.loading-dots {
		display: inline-flex;
		gap: 3px;
		align-items: center;
	}

	.loading-dots span {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: var(--muted);
		animation: dot 1.2s ease-in-out infinite;
	}

	.loading-dots span:nth-child(2) { animation-delay: 0.2s; }
	.loading-dots span:nth-child(3) { animation-delay: 0.4s; }

	@keyframes dot {
		0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
		40%            { transform: scale(1);   opacity: 1;   }
	}

	.prompt-note {
		margin-top: 20px;
		font-size: 12px;
		color: var(--faint);
		font-family: Georgia, serif;
		font-style: italic;
	}

	.post-content {
		animation: fadeUp 0.4s ease both;
	}
</style>

<script is:inline define:vars={{ postId, apiBaseUrl }}>
	const form = document.getElementById('password-form');
	const input = document.getElementById('password-input');
	const submitButton = form.querySelector('button[type="submit"]');
	const errorMessage = document.getElementById('error-message');
	const loadingMessage = document.getElementById('loading-message');
	const promptDiv = document.querySelector('.password-prompt');
	const contentDiv = document.getElementById('post-content');

	// Check if already unlocked in session
	const sessionKey = `post-unlocked-${postId}`;
	const cachedContent = sessionStorage.getItem(sessionKey);
	
	if (cachedContent) {
		promptDiv.style.display = 'none';
		contentDiv.innerHTML = cachedContent;
		contentDiv.style.display = 'block';
	}

	/**
	 * Derive encryption key from password using PBKDF2
	 */
	async function deriveKey(password, salt, iterations) {
		const encoder = new TextEncoder();
		const passwordBuffer = encoder.encode(password);
		const saltBuffer = base64ToBuffer(salt);

		// Import password as key material
		const keyMaterial = await crypto.subtle.importKey(
			'raw',
			passwordBuffer,
			{ name: 'PBKDF2' },
			false,
			['deriveBits', 'deriveKey']
		);

		// Derive key using PBKDF2
		const key = await crypto.subtle.deriveKey(
			{
				name: 'PBKDF2',
				salt: saltBuffer,
				iterations: iterations,
				hash: 'SHA-256'
			},
			keyMaterial,
			{ name: 'AES-GCM', length: 256 },
			false,
			['decrypt']
		);

		return key;
	}

	/**
	 * Decrypt content using AES-GCM
	 */
	async function decryptContent(encryptedData, password) {
		try {
			const key = await deriveKey(
				password,
				encryptedData.salt,
				encryptedData.iterations || 100000
			);

			const encryptedBuffer = base64ToBuffer(encryptedData.encrypted);
			const ivBuffer = base64ToBuffer(encryptedData.iv);
			const authTagBuffer = base64ToBuffer(encryptedData.authTag);

			// Combine encrypted data and auth tag for GCM
			const ciphertext = new Uint8Array(encryptedBuffer.byteLength + authTagBuffer.byteLength);
			ciphertext.set(new Uint8Array(encryptedBuffer), 0);
			ciphertext.set(new Uint8Array(authTagBuffer), encryptedBuffer.byteLength);

			// Decrypt
			const decryptedBuffer = await crypto.subtle.decrypt(
				{
					name: 'AES-GCM',
					iv: ivBuffer,
					tagLength: 128
				},
				key,
				ciphertext
			);

			const decoder = new TextDecoder();
			return decoder.decode(decryptedBuffer);
		} catch (error) {
			console.error('Decryption error:', error);
			throw new Error('Failed to decrypt content');
		}
	}

	/**
	 * Convert base64 string to ArrayBuffer
	 */
	function base64ToBuffer(base64) {
		const binaryString = atob(base64);
		const bytes = new Uint8Array(binaryString.length);
		for (let i = 0; i < binaryString.length; i++) {
			bytes[i] = binaryString.charCodeAt(i);
		}
		return bytes.buffer;
	}

	/**
	 * Simple markdown to HTML converter
	 */
	function markdownToHtml(markdown) {
		// Split into lines for processing
		const lines = markdown.split('\n');
		const processed = [];
		let inBlockquote = false;
		let blockquoteContent = [];
		
		for (let i = 0; i < lines.length; i++) {
			let line = lines[i];
			
			// Check if line is a blockquote
			if (line.startsWith('> ')) {
				if (!inBlockquote) {
					inBlockquote = true;
					blockquoteContent = [];
				}
				blockquoteContent.push(line.substring(2));
			} else {
				// If we were in a blockquote, close it
				if (inBlockquote) {
					processed.push('<blockquote>' + blockquoteContent.join('<br>') + '</blockquote>');
					inBlockquote = false;
					blockquoteContent = [];
				}
				processed.push(line);
			}
		}
		
		// Close any remaining blockquote
		if (inBlockquote) {
			processed.push('<blockquote>' + blockquoteContent.join('<br>') + '</blockquote>');
		}
		
		let html = processed.join('\n');
		
		// Horizontal rules
		html = html.replace(/^---+$/gim, '<hr>');
		
		// Headers
		html = html.replace(/^### (.*$)/gim, '<h3>$1</h3>');
		html = html.replace(/^## (.*$)/gim, '<h2>$1</h2>');
		html = html.replace(/^# (.*$)/gim, '<h1>$1</h1>');
		
		// Bold
		html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
		
		// Italic
		html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
		
		// Images (must come before links!)
		html = html.replace(/!\[([^\]]*)\]\(([^)]+)\)/g, '<img src="$2" alt="$1" />');
		
		// Links
		html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
		
		// Paragraphs - split by double newlines
		const blocks = html.split('\n\n');
		const htmlBlocks = blocks.map(block => {
			// Don't wrap headers, blockquotes, or hrs in paragraphs
			if (block.match(/^<h[1-6]>/) || block.match(/^<blockquote>/) || block.match(/^<hr>/)) {
				return block;
			}
			// Replace single newlines with <br> within paragraphs
			const content = block.replace(/\n/g, '<br>');
			return content.trim() ? '<p>' + content + '</p>' : '';
		});
		
		html = htmlBlocks.filter(b => b).join('\n');
		
		return html;
	}

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const password = input.value;

		// Show loading
		errorMessage.style.display = 'none';
		loadingMessage.style.display = 'block';
		submitButton.disabled = true;

		try {
			// Call server API to verify password
			// Use apiBaseUrl if configured, otherwise use relative URL
			const apiUrl = apiBaseUrl ? `${apiBaseUrl}/blog/verify` : '/blog/verify';
			const response = await fetch(apiUrl, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({ postId, password }),
			});

			const data = await response.json();

			if (data.success) {
				// Password verified! Now get encrypted data from page and decrypt on client side
				try {
					// Get encrypted data from the wrapper element
					const wrapper = document.getElementById('encrypted-content');
					if (!wrapper) {
						throw new Error('Encrypted content wrapper not found');
					}
					
					const encryptedDataStr = wrapper.getAttribute('data-encrypted-content');
					if (!encryptedDataStr) {
						throw new Error('Encrypted content data not found');
					}
					
					const encryptedData = JSON.parse(encryptedDataStr);
					const decryptedContent = await decryptContent(encryptedData, password);
					
					// Success! Render the content
					loadingMessage.style.display = 'none';
					promptDiv.style.display = 'none';
					
					// Convert markdown to HTML
					const htmlContent = markdownToHtml(decryptedContent);
					contentDiv.innerHTML = `<div class="markdown-content">${htmlContent}</div>`;
					contentDiv.style.display = 'block';
					
					// Store in session
					sessionStorage.setItem(sessionKey, contentDiv.innerHTML);
				} catch (decryptError) {
					console.error('Decryption error:', decryptError);
					showError('解密失败，请重试');
				}
			} else {
				// Wrong password
				showError(data.error || '密码错误，请重试');
			}
		} catch (error) {
			console.error('API error:', error);
			showError('验证失败，请重试');
		} finally {
			loadingMessage.style.display = 'none';
			submitButton.disabled = false;
		}
	});

	function showError(message) {
		errorMessage.innerHTML = '<span class="password-message__dot"></span>' + message;
		errorMessage.style.display = 'flex';
		input.classList.add('error');
		input.value = '';
		input.focus();
		
		// Remove error class after a delay
		setTimeout(() => {
			input.classList.remove('error');
		}, 2000);
	}
</script>