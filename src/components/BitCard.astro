---
import { type BitsEntry, getBitAnchorId } from '../lib/bits';
import { buildBitsCardViewModel } from '../lib/bits-card-view-model';
import { getThemeSettings } from '../lib/theme-settings';
import { excerptMarkdownToHtml } from '../utils/excerpt';

const {
  bit,
  excerpt = '',
  Content = null,
  shouldRenderFull = false,
  prioritizeLeadMedia = false
} = Astro.props;

const bitEntry = bit as BitsEntry;
const base = import.meta.env.BASE_URL ?? '/';
const { settings } = getThemeSettings();
const card = buildBitsCardViewModel({
  id: bitEntry.id,
  slug: bitEntry.data.slug,
  bodyText: bitEntry.body ?? '',
  tags: bitEntry.data.tags ?? [],
  date: bitEntry.data.date,
  images: bitEntry.data.images ?? [],
  ...(bitEntry.data.author ? { author: bitEntry.data.author } : {}),
  defaultAuthor: settings.page.bits.defaultAuthor,
  base
});
const previewExcerpt = excerpt || (!Content ? card.body.excerpt : '');
const previewExcerptHtml = previewExcerpt ? excerptMarkdownToHtml(previewExcerpt) : '';
const maxVisible = 4;
const getImageLoading = (prioritize: boolean) => (prioritize ? 'eager' : 'lazy');
const getImageFetchPriority = (prioritize: boolean) => (prioritize ? 'high' : undefined);
const shouldUseExpandableBody = Boolean(Content) && !shouldRenderFull;
---

<article
  class="bit-card"
  id={getBitAnchorId(bitEntry.id)}
  data-bit
  data-bit-key={bitEntry.id}
  data-slug={card.slug}
>
  <div class="bit-author">
    <div class={`avatar${card.authorAvatar ? ' avatar--image' : ' is-fallback'}`} aria-hidden="true">
      {card.authorAvatar ? (
        <img
          src={card.authorAvatar}
          alt=""
          width="32"
          height="32"
          loading="lazy"
          decoding="async"
          onerror="this.parentElement?.classList.add('is-fallback'); this.remove();"
        />
      ) : null}
      <span class="avatar-fallback">{card.avatarLetter}</span>
    </div>
    <div class="name">{card.authorName}</div>
  </div>

  {Content ? (
    shouldUseExpandableBody ? (
      <div class="bit-body" data-bit-expandable data-bit-fading="idle">
        <div class="bit-body__preview" data-bit-expandable-preview>
          <span class="bit-body__preview-text" set:html={previewExcerptHtml}></span>
          <button
            type="button"
            class="bit-body__inline-toggle"
            data-bit-expandable-toggle
            aria-expanded="false"
          >
            展开
          </button>
        </div>
        <div class="bit-body__content" data-bit-expandable-content hidden>
          <Content />
          <button
            type="button"
            class="bit-body__inline-toggle bit-body__inline-toggle--collapse"
            data-bit-expandable-collapse
            aria-expanded="true"
          >
            收起
          </button>
        </div>
      </div>
    ) : (
      <div class="bit-body">
        <Content />
      </div>
    )
  ) : previewExcerptHtml ? (
    <div class="bit-body">
      <p set:html={previewExcerptHtml} />
    </div>
  ) : null}

  {card.firstImage ? (
    <div class="bit-media bit-media--single">
      <button
        type="button"
        class="bit-media-item bit-media-item--single"
        data-bit-image-button
        data-bit-image-index="0"
        aria-label="查看图片预览"
      >
        <img
          src={card.firstImage.src}
          alt={card.firstImage.alt}
          width={card.firstImage.width}
          height={card.firstImage.height}
          loading={getImageLoading(prioritizeLeadMedia)}
          fetchpriority={getImageFetchPriority(prioritizeLeadMedia)}
        />
      </button>
    </div>
  ) : card.imageItems.length > 1 ? (
    <div class="bit-media bit-media--grid">
      <div class="bit-media-grid">
        {card.visibleImages.map((image, index) => {
          const isMore = index === maxVisible - 1 && card.imageItems.length > maxVisible;
          return (
            <button
              type="button"
              class={`bit-media-item${index === card.wideIndex ? ' bit-media-item--wide' : ''}${isMore ? ' bit-media-item--more' : ''}`}
              data-bit-image-button
              data-bit-image-index={index}
              aria-label={isMore ? `查看全部图片（共 ${card.imageItems.length} 张）` : `图片 ${index + 1}`}
            >
              <img
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading={getImageLoading(prioritizeLeadMedia && index === 0)}
                fetchpriority={getImageFetchPriority(prioritizeLeadMedia && index === 0)}
              />
              {isMore ? (
                <>
                  <span class="bit-media-more" aria-hidden="true" data-bit-image-open-hidden={maxVisible}>
                    <span class="bit-media-more-short">+ {card.imageItems.length - maxVisible}</span>
                    <span class="bit-media-more-full">查看其余{card.imageItems.length - maxVisible}张</span>
                  </span>
                </>
              ) : null}
            </button>
          );
        })}
      </div>
    </div>
  ) : null}

  {card.imageItems.length ? (
    <div hidden aria-hidden="true">
      {card.imageItems.map((image) => (
        <span
          data-bit-image-item
          data-bit-image-src={image.src}
          data-bit-image-alt={image.alt}
          data-bit-image-width={image.width}
          data-bit-image-height={image.height}
        ></span>
      ))}
    </div>
  ) : null}

  <div class="bit-meta">
    {card.hasTags ? (
      <div class="bit-tags">
        {card.placeText ? (
          <span class="bit-tag bit-tag--place">
            <span class="bit-tag-icon" aria-hidden="true">📍</span>
            <span class="bit-tag-text">{card.placeText}</span>
          </span>
        ) : null}
        {card.normalTagItems.length ? (
          <span class="bit-tag bit-tag--normal">
            <span class="bit-tag-icon" aria-hidden="true">❤</span>
            <span class="bit-tag-list">
              {card.normalTagItems.map((tag) => (
                <span class="bit-tag-token">{tag}</span>
              ))}
            </span>
          </span>
        ) : null}
      </div>
    ) : null}
    <div>{card.dateLabel}</div>
  </div>
  <script>
    (() => {
      const cards = document.querySelectorAll<HTMLElement>('[data-bit-expandable]');

      cards.forEach((container) => {
        const preview = container.querySelector<HTMLElement>('[data-bit-expandable-preview]');
        const content = container.querySelector<HTMLElement>('[data-bit-expandable-content]');
        const toggle = container.querySelector<HTMLButtonElement>('[data-bit-expandable-toggle]');
        const collapse = container.querySelector<HTMLButtonElement>('[data-bit-expandable-collapse]');
          
        if (!preview || !content || !toggle || !collapse || toggle.dataset.bound === 'true') return;
        const previewHeight = preview.getBoundingClientRect().height;

        let collapseFadeFrame = 0;

        const resetInlineFade = () => {
          preview.style.removeProperty('opacity');
          content.style.removeProperty('opacity');
        };

        const stopCollapseFade = () => {
          if (collapseFadeFrame) {
            cancelAnimationFrame(collapseFadeFrame);
            collapseFadeFrame = 0;
          }
        };

        const finishExpandedState = () => {
          stopCollapseFade();
          resetInlineFade();
          container.classList.remove('is-expanding', 'is-collapsing');
          container.classList.add('is-expanded');
          container.style.removeProperty('--bit-body-current-max-height');
        };

        toggle.dataset.bound = 'true';

        toggle.addEventListener('click', () => {
          stopCollapseFade();
          resetInlineFade();

          const previewHeight = preview.getBoundingClientRect().height;
          container.classList.remove('is-expanded', 'is-collapsing');
          container.style.setProperty('--bit-body-current-max-height', `${previewHeight}px`);
          container.classList.add('is-expanding');

          preview.hidden = true;
          content.hidden = false;
          toggle.setAttribute('aria-expanded', 'true');

          requestAnimationFrame(() => {
            const fullHeight = content.scrollHeight;
            container.style.setProperty('--bit-body-current-max-height', `${fullHeight + 26}px`);
          });
        });

        collapse.addEventListener('click', () => {
          stopCollapseFade();

          // const currentPreviewHeight = preview.getBoundingClientRect().height;
          const fullHeight = content.scrollHeight;
          const collapseDistance = Math.max(fullHeight - previewHeight, 1);

          container.classList.remove('is-expanded', 'is-expanding');
          container.style.setProperty('--bit-body-current-max-height', `${fullHeight}px`);
          container.classList.add('is-collapsing');

          preview.hidden = false;
          preview.style.opacity = '0';
          content.hidden = false;
          content.style.opacity = '1';
          toggle.setAttribute('aria-expanded', 'false');

          const syncCollapseFade = () => {
            if (!container.classList.contains('is-collapsing')) {
              stopCollapseFade();
              return;
            }

            const currentHeight = container.getBoundingClientRect().height;
            const progress = Math.min(Math.max((fullHeight - currentHeight) / collapseDistance, 0), 1);

            preview.style.opacity = `${progress}`;
            content.style.opacity = `${1 - progress}`;

            if (progress < 1) {
              collapseFadeFrame = requestAnimationFrame(syncCollapseFade);
              return;
            }

            collapseFadeFrame = 0;
          };

          collapseFadeFrame = requestAnimationFrame(syncCollapseFade);

          requestAnimationFrame(() => {
            container.style.setProperty('--bit-body-current-max-height', `${previewHeight}px`);
          });
        });

        container.addEventListener('transitionend', (event) => {
          if (!(event.target instanceof HTMLElement) || event.target !== container) return;
          if (event.propertyName !== 'max-height') return;

          if (container.classList.contains('is-expanding')) {
            finishExpandedState();
            return;
          }

          if (!container.classList.contains('is-collapsing')) return;

          stopCollapseFade();
          container.classList.remove('is-collapsing', 'is-expanded');
          content.hidden = true;
          preview.hidden = false;
          resetInlineFade();
          container.style.removeProperty('--bit-body-current-max-height');
        });
      });
    })();
  </script>
</article>
