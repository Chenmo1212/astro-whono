  "overrides": {
    "nanoid": "3.3.18",
    "ajv": "8.18.0",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "esbuild": "0.28.1",
    "fast-xml-parser": "5.7.0",
    "h3": "1.15.9",
    "js-yaml": "4.3.1",
    "picomatch": "4.0.4",
    "postcss": "8.5.25",
    "rollup": "4.59.0",
    "sharp": "0.35.3",
    "svgo": "4.0.2",
    "vite": "8.2.0",
