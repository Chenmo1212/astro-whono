    "@lucide/svelte": "^1.28.0",
    "@shikijs/rehype": "^4.0.2",
    "@types/node": "^22.0.0",
    "@types/qrcode-generator": "^0.0.16",
    "emoji-picker-element": "^1.29.1",
    "emoji-picker-element-data": "^1.8.0",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
